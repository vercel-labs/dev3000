{
  "name": "dev3000",
  "version": "0.0.189-canary",
  "description": "Agent-first local web debugging runtime with unified server and browser context",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dev3000": "./bin/dev3000",
    "d3k": "./bin/dev3000",
    "d3k-runtime": "./bin/d3k-runtime"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "skills/d3k/"
  ],
  "scripts": {
    "build": "./node_modules/@typescript/native/bin/tsc && mkdir -p dist/src && cp src/loading.html dist/src/",
    "typegen": "./scripts/typegen.sh",
    "typecheck": "./node_modules/@typescript/native/bin/tsc --noEmit && bun run --filter '*' typecheck",
    "format": "biome format --write .",
    "lint": "biome check src www scripts --vcs-use-ignore-file=true",
    "lint:fix": "biome check --write src www scripts",
    "test": "vitest run",
    "test-release": "./scripts/test-release.sh",
    "canary:smoke": "bun run scripts/canary-smoke-test.ts",
    "_prepare": "husky",
    "release": "./scripts/release.sh",
    "canary": "./scripts/canary.sh"
  },
  "keywords": [
    "nextjs",
    "ai",
    "development",
    "chrome-devtools-protocol",
    "cdp",
    "browser-monitoring",
    "debugging",
    "claude"
  ],
  "dependencies": {
    "@vercel/sandbox": "^3.9.0",
    "agent-browser": "0.39.2",
    "commander": "15.0.0",
    "portless": "0.15.12",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/dev3000.git"
  },
  "author": "Lindsey Simon <lindsey@vercel.com>",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "www"
  ],
  "overrides": {
    "@xhmikosr/decompress": "11.1.4",
    "body-parser": "2.4.0",
    "defu": "6.1.7",
    "devalue": "5.9.4",
    "linkify-it": "6.1.0",
    "nanoid": "5.1.16",
    "path-to-regexp": "8.4.2",
    "piscina": "5.3.2",
    "postcss": "8.5.32",
    "qs": "6.16.0",
    "rollup": "4.64.3",
    "seroval": "1.6.9",
    "vite": "8.3.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  }
}
